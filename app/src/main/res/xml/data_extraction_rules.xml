<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Back up user created playlists, favorites, and user-edited lyrics -->
        <include domain="database" path="liquid_music_database" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="liquid_music_database" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
